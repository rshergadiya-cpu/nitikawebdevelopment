      <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Amet, provident!</p>
      <button>Register</button>
    </div>
  </section>

  <!-- SECTION: Buy What's New -->
  <h2 class="mid-title">BUY WHAT’S NEW</h2>

  <section class="products">
    <div class="product">
